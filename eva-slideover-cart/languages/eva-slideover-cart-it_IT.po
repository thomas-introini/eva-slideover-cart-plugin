#: eva-slideover-cart/includes/class-settings.php:41
#: eva-slideover-cart/includes/class-settings.php:42
msgid "Slideover Cart"
msgstr "Carrello laterale"

#: eva-slideover-cart/includes/class-settings.php:62
msgid "General"
msgstr "Generale"

#: eva-slideover-cart/includes/class-settings.php:69
msgid "Enable Slideover Cart"
msgstr "Abilita il carrello laterale"

#: eva-slideover-cart/includes/class-settings.php:75
msgid "Activate the drawer cart on the frontend."
msgstr "Attiva il carrello laterale sul frontend."

#: eva-slideover-cart/includes/class-settings.php:81
msgid "Open on Add to Cart"
msgstr "Apri all’aggiunta al carrello"

#: eva-slideover-cart/includes/class-settings.php:87
msgid "Automatically open the cart drawer when a product is added to the cart."
msgstr "Apri automaticamente il carrello laterale quando viene aggiunto un prodotto."

#: eva-slideover-cart/includes/class-settings.php:93
msgid "Free Shipping Progress"
msgstr "Avanzamento spedizione gratuita"

#: eva-slideover-cart/includes/class-settings.php:102
msgid "Disable Theme Mini-Cart"
msgstr "Disabilita il mini-carrello del tema"

#: eva-slideover-cart/includes/class-settings.php:109
msgid "Theme Mod Keys to Disable (Tactic A)"
msgstr "Chiavi theme_mod da disabilitare (Strategia A)"

#: eva-slideover-cart/includes/class-settings.php:115
msgid ""
"One theme_mod key per line. The plugin will force these to <code>false</"
"code>. Example: <code>header_cart</code>"
msgstr "Una chiave theme_mod per riga. Il plugin ne forzerà il valore a <code>false</code>. Esempio: <code>header_cart</code>"

#: eva-slideover-cart/includes/class-settings.php:122
msgid "Action Callbacks to Remove (Tactic B)"
msgstr "Callback delle azioni da rimuovere (Strategia B)"

#: eva-slideover-cart/includes/class-settings.php:128
msgid ""
"One entry per line as <code>hook|identifier</code>. Identifier is a function "
"name or <code>ClassName::method</code>. Example: <code>wp_footer|Astra_Cart::"
"render_cart</code>"
msgstr "Una voce per riga nel formato <code>hook|identificatore</code>. L’identificatore è il nome di una funzione o <code>NomeClasse::metodo</code>. Esempio: <code>wp_footer|Astra_Cart::render_cart</code>"

#: eva-slideover-cart/includes/class-settings.php:135
msgid "CSS Selectors to Hide (Tactic C)"
msgstr "Selettori CSS da nascondere (Strategia C)"

#: eva-slideover-cart/includes/class-settings.php:141
msgid ""
"One CSS selector per line. Matching elements will receive <code>display:"
"none !important</code>. Example: <code>.site-header-cart</code>"
msgstr "Un selettore CSS per riga. Gli elementi corrispondenti riceveranno <code>display:none !important</code>. Esempio: <code>.site-header-cart</code>"

#: eva-slideover-cart/includes/class-settings.php:152
msgid ""
"Use one or more tactics below to suppress the theme's own mini-cart without "
"editing theme files."
msgstr "Utilizza una o più delle strategie seguenti per nascondere il mini-carrello del tema senza modificarne i file."

#: eva-slideover-cart/includes/class-settings.php:198
msgid "You do not have permission to access this page."
msgstr "Non disponi dei permessi necessari per accedere a questa pagina."

#: eva-slideover-cart/includes/class-settings.php:202
msgid "Eva Slideover Cart"
msgstr "Eva Slideover Cart"

#: eva-slideover-cart/includes/class-settings.php:263
msgid ""
"The drawer uses the applicable WooCommerce Free shipping method for the "
"customer’s shipping zone, including its minimum order amount and coupon "
"requirements. Configure this under WooCommerce → Settings → Shipping."
msgstr "Il carrello laterale utilizza il metodo di spedizione gratuita di WooCommerce applicabile alla zona di spedizione del cliente, inclusi l’importo minimo dell’ordine e i requisiti dei coupon. Configuralo in WooCommerce → Impostazioni → Spedizione."

#: eva-slideover-cart/includes/class-settings.php:278
msgid ""
"No shipping classes found. Create them under WooCommerce → Settings → "
"Shipping → Shipping classes."
msgstr "Nessuna classe di spedizione trovata. Creale in WooCommerce → Impostazioni → Spedizione → Classi di spedizione."

